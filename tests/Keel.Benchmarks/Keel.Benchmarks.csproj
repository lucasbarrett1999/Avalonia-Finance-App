<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- BenchmarkDotNet requires optimized builds; run with -c Release. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Keel.Domain\Keel.Domain.csproj" />
    <ProjectReference Include="..\..\src\Keel.Infrastructure\Keel.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The deterministic budget input generator is shared with Keel.Domain.Tests. -->
    <Compile Include="..\Keel.Domain.Tests\Budgeting\BudgetInputGenerator.cs" Link="Budgeting\BudgetInputGenerator.cs" />
    <Compile Include="..\Keel.Domain.Tests\Categorization\LabeledHistoryGenerator.cs" Link="Categorization\LabeledHistoryGenerator.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- M5: the deterministic recurring ledger generator is shared with Keel.Domain.Tests. -->
    <Compile Include="..\Keel.Domain.Tests\Recurring\RecurringSeries.cs" Link="Recurring\RecurringSeries.cs" />
  </ItemGroup>
</Project>
