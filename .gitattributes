# Normalize text to LF in the repository and working tree (matches .editorconfig).
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.zip binary
*.keel binary

# Verify golden files (budget calculator): byte-exact, LF, UTF-8 with BOM as Verify writes them.
*.verified.txt text eol=lf working-tree-encoding=UTF-8
