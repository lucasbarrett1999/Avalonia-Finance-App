<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="20">
      <TextBlock Text="Dashboard Overview" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

        <!-- Net Worth Summary -->
        <Border Grid.Row="0" Grid.Column="0" Classes="ContentArea" CornerRadius="5" Padding="15" MinHeight="150" Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Text="Net Worth Summary" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Current Net Worth: $XXX,XXX.XX" Foreground="LightGreen"/>
            <TextBlock Text="Change from last month: +$X,XXX.XX" />
            <!-- Placeholder for a small chart or more details -->
            <TextBlock Text="[Chart/Details]" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- Recent Transactions -->
        <Border Grid.Row="0" Grid.Column="1" Classes="ContentArea" CornerRadius="5" Padding="15" MinHeight="150" Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Text="Recent Transactions" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Transaction 1: - $XX.XX (Vendor A)" />
            <TextBlock Text="Transaction 2: + $YY.YY (Vendor B)" />
            <TextBlock Text="Transaction 3: - $ZZ.ZZ (Vendor C)" />
            <Button Content="View All Transactions" />
          </StackPanel>
        </Border>

        <!-- Spending By Category -->
        <Border Grid.Row="1" Grid.Column="0" Classes="ContentArea" CornerRadius="5" Padding="15" MinHeight="150" Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Text="Spending By Category (This Month)" FontSize="18" FontWeight="SemiBold"/>
            <!-- Placeholder for a pie chart or bar chart -->
            <TextBlock Text="[Category Chart]" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Groceries: $XXX.XX" />
            <TextBlock Text="Utilities: $YYY.YY" />
          </StackPanel>
        </Border>

        <!-- Budget Overview -->
        <Border Grid.Row="1" Grid.Column="1" Classes="ContentArea" CornerRadius="5" Padding="15" MinHeight="150" Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Text="Budget Overview" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Total Budgeted: $B,BBB.BB" />
            <TextBlock Text="Total Spent: $S,SSS.SS" />
            <TextBlock Text="Remaining: $R,RRR.RR" Foreground="LightGreen"/>
            <!-- Placeholder for budget progress bars or details -->
            <TextBlock Text="[Budget Details/Progress]" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl> 