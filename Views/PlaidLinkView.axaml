<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MyApp.Views.PlaidLinkView"
             x:DataType="vm:PlaidLinkViewModel">

  <Design.DataContext>
    <vm:PlaidLinkViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="20">
      <TextBlock Text="Connect Your Bank Account" 
                 FontSize="24" 
                 FontWeight="Bold" 
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>
      <TextBlock Text="Securely connect your accounts using Plaid's trusted service." 
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>
      <TextBlock Text="{Binding StatusMessage}" 
                 HorizontalAlignment="Center"
                 Margin="0,10,0,0"
                 FontWeight="SemiBold"/>
    </StackPanel>

    <!-- Main Content Area -->
    <Grid Grid.Row="1" Margin="20,0">
      <!-- Loading Indicator -->
      <ProgressBar IsIndeterminate="True" 
                   IsVisible="{Binding IsLoading}"
                   VerticalAlignment="Top"
                   Margin="0,10,0,0"
                   Height="4"/>

      <!-- WebView Container -->
      <Border IsVisible="{Binding IsWebViewVisible}"
              BorderBrush="{DynamicResource SystemAccentColor}"
              BorderThickness="1"
              CornerRadius="8"
              ClipToBounds="True">
        <!-- WebView will be created programmatically in code-behind -->
        <Panel x:Name="WebViewContainer" Background="White" MinHeight="400">
          <TextBlock Text="Loading bank connection interface..."
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsLoading}"/>
        </Panel>
      </Border>

      <!-- Success State -->
      <StackPanel IsVisible="{Binding IsSuccess}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="20">
        <Panel Width="80" Height="80">
          <Ellipse Fill="Green" Width="80" Height="80"/>
          <Path Data="M 20,40 L 35,55 L 60,25"
                Stroke="White"
                StrokeThickness="5"
                StrokeLineCap="Round"/>
        </Panel>
        <TextBlock Text="Successfully Connected!"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>
        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   MaxWidth="500"/>
      </StackPanel>

      <!-- Error State -->
      <StackPanel IsVisible="{Binding IsError}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="20">
        <Panel Width="80" Height="80">
          <Ellipse Fill="Red" Width="80" Height="80"/>
          <TextBlock Text="!"
                     Foreground="White"
                     FontSize="50"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Panel>
        <TextBlock Text="Connection Error"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>
        <TextBlock Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   MaxWidth="500"/>
        <Button Content="Try Again"
                Command="{Binding RetryCommand}"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Classes="accent"/>
      </StackPanel>
    </Grid>

    <!-- Footer Buttons -->
    <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center"
                Margin="20"
                Spacing="10">
      <Button Content="Cancel" 
              Command="{Binding CancelCommand}"
              Width="120"
              IsVisible="{Binding IsWebViewVisible}"/>
      <Button Content="Go Back" 
              Command="{Binding GoBackCommand}"
              Width="120"
              IsVisible="{Binding !IsWebViewVisible}"/>
    </StackPanel>
  </Grid>
</UserControl>