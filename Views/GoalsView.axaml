<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyApp.Views.GoalsView"
             x:DataType="vm:GoalsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="20">
      <TextBlock Text="Financial Goals" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
      
      <!-- Placeholder for goals listing -->
      <Border Classes="ContentArea" CornerRadius="5" Padding="15" MinHeight="300">
        <TextBlock Text="A list of financial goals, their progress, target dates, and management options will be displayed here."
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>
      </Border>

      <!-- Placeholder for actions -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
        <Button Content="Add New Goal"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl> 