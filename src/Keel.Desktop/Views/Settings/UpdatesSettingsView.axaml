<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keel.Desktop.ViewModels.Settings"
             xmlns:res="using:Keel.Desktop.Resources"
             x:Class="Keel.Desktop.Views.Settings.UpdatesSettingsView"
             x:DataType="vm:UpdatesSettingsViewModel">
  <StackPanel Spacing="10">
    <TextBlock x:Name="VersionText" Text="{Binding VersionText}" />
    <CheckBox x:Name="UpdatesToggle" IsChecked="{Binding CheckForUpdates}" Content="{x:Static res:Strings.Settings_UpdatesToggle}" />
    <TextBlock Classes="secondary" Text="{x:Static res:Strings.Settings_UpdatesHint}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="CheckUpdatesButton" Command="{Binding CheckNowCommand}" Content="{x:Static res:Strings.Settings_UpdatesCheckNow}" />
      <Button Classes="accent" Command="{Binding InstallCommand}" Content="{x:Static res:Strings.Settings_UpdatesInstall}" IsVisible="{Binding Updates.IsUpdateAvailable}" />
    </StackPanel>
    <TextBlock Text="{Binding Updates.StatusText}" IsVisible="{Binding Updates.StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
