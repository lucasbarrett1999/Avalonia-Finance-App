<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:Keel.Desktop.ViewModels.Dialogs"
             xmlns:res="using:Keel.Desktop.Resources"
             x:Class="Keel.Desktop.Views.Dialogs.PickerDialogView"
             x:DataType="dlg:PickerDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <StackPanel Spacing="12" Width="400">
    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Keel.FontSize.Heading}" FontWeight="SemiBold" />
    <TextBlock Classes="secondary" Text="{Binding Prompt}" TextWrapping="Wrap" />
    <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Watermark="{x:Static res:Strings.Picker_Search}"
             AutomationProperties.Name="{x:Static res:Strings.Picker_Search}">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
      </TextBox.KeyBindings>
    </TextBox>
    <ListBox x:Name="ItemList" ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" Height="260">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="dlg:PickerItem">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Command="{Binding CancelCommand}" Content="{x:Static res:Strings.Dialog_Cancel}" />
      <Button Classes="accent" Command="{Binding ConfirmCommand}" Content="{x:Static res:Strings.Dialog_Ok}" />
    </StackPanel>
  </StackPanel>
</UserControl>
