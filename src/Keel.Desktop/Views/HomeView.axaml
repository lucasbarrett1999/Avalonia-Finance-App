<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keel.Desktop.ViewModels"
             xmlns:controls="using:Keel.Desktop.Controls"
             x:Class="Keel.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel Margin="{StaticResource Keel.PagePadding}">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Classes="pageTitle" Text="{Binding Title}" />
      <TextBlock Classes="pageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>
    <controls:EmptyState Icon="{StaticResource Icon.Home}" Heading="{Binding EmptyHeading}" Message="{Binding EmptyMessage}">
      <Border Classes="card" Padding="16,10" ToolTip.Tip="{Binding FilePath}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:Icon Data="{StaticResource Icon.File}" Width="16" Height="16"
                         Foreground="{DynamicResource Keel.TextSecondary}" />
          <TextBlock Classes="secondary" Text="{Binding FileLabel}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </controls:EmptyState>
  </DockPanel>
</UserControl>
