<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:al="using:Keel.Desktop.ViewModels.Alerts"
             xmlns:controls="using:Keel.Desktop.Controls"
             xmlns:res="using:Keel.Desktop.Resources"
             x:Class="Keel.Desktop.Views.Alerts.NotificationCenterView"
             x:DataType="al:NotificationCenterViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Keel.BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12,8,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Theme="{StaticResource IconButtonTheme}" Command="{Binding CloseCommand}" MinWidth="28" MinHeight="28" Padding="4"
                ToolTip.Tip="{x:Static res:Strings.Alerts_Close}" AutomationProperties.Name="{x:Static res:Strings.Alerts_Close}">
          <controls:Icon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
        </Button>
        <Button DockPanel.Dock="Right" x:Name="MarkAllReadButton" Classes="link" Margin="0,0,12,0" VerticalAlignment="Center"
                Command="{Binding MarkAllReadCommand}" IsVisible="{Binding HasUnread}" Content="{x:Static res:Strings.Alerts_MarkAllRead}" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{x:Static res:Strings.Alerts_Title}" FontWeight="SemiBold" FontSize="15" />
          <Border Classes="badge" IsVisible="{Binding HasUnread}">
            <TextBlock Text="{Binding BadgeText}" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" Margin="16,8,16,12" TextWrapping="Wrap"
               Text="{x:Static res:Strings.Alerts_LocalOnly}" />

    <Panel>
      <StackPanel IsVisible="{Binding !HasItems}" Spacing="6" Margin="24,32" HorizontalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" Background="{DynamicResource Keel.IconCircle}">
          <controls:Icon Data="{StaticResource Icon.Bell}" Width="20" Height="20" Foreground="{DynamicResource Keel.IconCircleForeground}" />
        </Border>
        <TextBlock Text="{x:Static res:Strings.Alerts_EmptyHeading}" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Classes="secondary" Text="{x:Static res:Strings.Alerts_EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding HasItems}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="AlertList" ItemsSource="{Binding Items}" Margin="8,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="al:AlertItemViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <Button Classes="chartRow" Padding="8,8" Command="{Binding $parent[ItemsControl].((al:NotificationCenterViewModel)DataContext).OpenCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Margin="0,0,10,0"
                            Background="{DynamicResource Keel.IconCircle}">
                      <controls:Icon Data="{Binding IconKey, Converter={x:Static controls:ReportIconConverter.Instance}}" Width="16" Height="16"
                                     Foreground="{DynamicResource Keel.IconCircleForeground}" />
                    </Border>
                    <StackPanel Spacing="2">
                      <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Classes="unreadDot" Margin="8,0,0,0" IsVisible="{Binding IsUnread}"
                                 ToolTip.Tip="{x:Static res:Strings.Alerts_Unread}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </DockPanel>
                      <TextBlock Classes="secondary" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <TextBlock Classes="secondary" FontSize="11" Text="{Binding TimeText}" />
                    </StackPanel>
                  </DockPanel>
                </Button>
                <Button Grid.Column="1" Theme="{StaticResource IconButtonTheme}" VerticalAlignment="Top" MinWidth="28" MinHeight="28" Padding="4" Margin="2,6,0,0"
                        Command="{Binding $parent[ItemsControl].((al:NotificationCenterViewModel)DataContext).DismissCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{x:Static res:Strings.Alerts_Dismiss}" AutomationProperties.Name="{x:Static res:Strings.Alerts_Dismiss}">
                  <controls:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
