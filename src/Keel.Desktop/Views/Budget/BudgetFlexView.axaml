<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="using:Keel.Desktop.ViewModels.Budget"
             xmlns:controls="using:Keel.Desktop.Controls"
             xmlns:res="using:Keel.Desktop.Resources"
             x:Class="Keel.Desktop.Views.Budget.BudgetFlexView"
             x:DataType="b:BudgetFlexViewModel">
  <!-- The Flex view (F-BUD-6, ADR 0091): the same month as the grid, summed by Flex kind. Every number drills down. -->
  <ScrollViewer x:Name="FlexScroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="0,0,8,8" MaxWidth="880" HorizontalAlignment="Left">
      <!-- The one Flex number with its spending progress -->
      <Button x:Name="FlexNumberButton" Classes="flexTile" Command="{Binding ShowFlexCommand}"
              AutomationProperties.Name="{Binding FlexAutomationName}" ToolTip.Tip="{x:Static res:Strings.Flex_ShowCategoriesTip}">
        <StackPanel Spacing="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="flexDetail" Text="{Binding MonthTitle}" VerticalAlignment="Center" />
            <TextBlock Classes="flexLabel" Text="{x:Static res:Strings.Flex_FlexNumberLabel}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="FlexNumberText" Classes="flexNumber" Text="{Binding FlexText}" />
          <TextBlock Classes="flexDetail" Text="{Binding FlexBreakdown}" />
          <Panel x:Name="ProgressTrack" Margin="0,8,0,0">
            <ProgressBar x:Name="FlexProgressBar" Classes="flexProgress" Classes.over="{Binding IsFlexOver}" Value="{Binding FlexProgress}"
                         AutomationProperties.Name="{Binding ProgressAutomationName}" />
            <Border x:Name="PaceMarker" Classes="paceMarker" ToolTip.Tip="{x:Static res:Strings.Flex_TodayMarker}" />
          </Panel>
          <DockPanel>
            <TextBlock x:Name="FlexLeftText" DockPanel.Dock="Right" FontWeight="SemiBold" FontFeatures="+tnum" Classes.flexOver="{Binding IsFlexOver}"
                       Text="{Binding FlexLeftText}" />
            <TextBlock x:Name="FlexSpentText" FontFeatures="+tnum" Text="{Binding FlexSpentText}" />
          </DockPanel>
          <TextBlock x:Name="PaceText" Classes="flexDetail" Text="{Binding PaceText}" />
        </StackPanel>
      </Button>

      <!-- Income, Fixed, Non-monthly -->
      <Grid ColumnDefinitions="*,12,*,12,*">
        <Button Grid.Column="0" x:Name="IncomeTile" Classes="flexTile" Command="{Binding ShowIncomeCommand}"
                AutomationProperties.Name="{Binding IncomeAutomationName}" ToolTip.Tip="{x:Static res:Strings.Flex_ShowTransactionsTip}">
          <StackPanel>
            <TextBlock Classes="flexLabel" Text="{x:Static res:Strings.Flex_Income}" />
            <TextBlock x:Name="IncomeText" Classes="flexAmount" Text="{Binding IncomeText}" />
            <TextBlock Classes="flexDetail" Text="{x:Static res:Strings.Flex_IncomeHint}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" x:Name="FixedTile" Classes="flexTile" Command="{Binding ShowFixedCommand}"
                AutomationProperties.Name="{Binding FixedAutomationName}" ToolTip.Tip="{x:Static res:Strings.Flex_ShowCategoriesTip}">
          <StackPanel>
            <TextBlock Classes="flexLabel" Text="{x:Static res:Strings.Flex_Fixed}" />
            <TextBlock x:Name="FixedText" Classes="flexAmount" Text="{Binding FixedText}" />
            <TextBlock Classes="flexDetail" Text="{Binding FixedDetail}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" x:Name="NonMonthlyTile" Classes="flexTile" Command="{Binding ShowNonMonthlyCommand}"
                AutomationProperties.Name="{Binding NonMonthlyAutomationName}" ToolTip.Tip="{x:Static res:Strings.Flex_ShowCategoriesTip}">
          <StackPanel>
            <TextBlock Classes="flexLabel" Text="{x:Static res:Strings.Flex_NonMonthly}" />
            <TextBlock x:Name="NonMonthlyText" Classes="flexAmount" Text="{Binding NonMonthlyText}" />
            <TextBlock Classes="flexDetail" Text="{Binding NonMonthlyDetail}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Hints -->
      <Border Classes="warning" IsVisible="{Binding HasNoFlexCategories}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:Icon Data="{StaticResource Icon.Info}" Width="14" Height="14" Foreground="{DynamicResource Keel.Warning}" />
          <TextBlock x:Name="NoFlexHint" Text="{x:Static res:Strings.Flex_NoFlexCategories}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:Icon Data="{StaticResource Icon.Info}" Width="14" Height="14" Foreground="{DynamicResource Keel.TextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Classes="secondary" Text="{x:Static res:Strings.Flex_Explainer}" TextWrapping="Wrap" MaxWidth="820" />
      </StackPanel>
      <TextBlock Classes="secondary" Text="{Binding CardPaymentsNote}" IsVisible="{Binding HasCardPayments}" TextWrapping="Wrap" Margin="22,0,0,0" MaxWidth="820" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
