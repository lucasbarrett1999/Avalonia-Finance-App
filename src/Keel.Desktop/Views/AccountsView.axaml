<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keel.Desktop.ViewModels"
             xmlns:reg="using:Keel.Desktop.ViewModels.Register"
             xmlns:bills="using:Keel.Desktop.ViewModels.Bills"
             xmlns:controls="using:Keel.Desktop.Controls"
             xmlns:res="using:Keel.Desktop.Resources"
             x:Class="Keel.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">
  <DockPanel Margin="{StaticResource Keel.PagePadding}">
    <!-- Header: name, type, actions -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button x:Name="AddTransactionButton" Classes="tool accent" Command="{Binding NewTransactionCommand}"
                IsEnabled="{Binding CanAddTransaction}" ToolTip.Tip="{x:Static res:Strings.Register_AddTransaction}"
                AutomationProperties.Name="{x:Static res:Strings.Register_AddTransaction}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Plus}" />
            <TextBlock Text="{x:Static res:Strings.Register_AddTransaction}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ImportFileButton" Classes="tool" Command="{Binding ImportFileCommand}" IsVisible="{Binding CanImportFile}"
                ToolTip.Tip="{x:Static res:Strings.Register_ImportFileTip}"
                AutomationProperties.Name="{x:Static res:Strings.Register_ImportFile}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Import}" />
            <TextBlock Text="{x:Static res:Strings.Register_ImportFile}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ScheduleTransactionButton" Classes="tool" Command="{Binding Scheduled.NewScheduleCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding CanAddTransaction}" ToolTip.Tip="{x:Static res:Strings.Schedule_AddTitle}"
                AutomationProperties.Name="{x:Static res:Strings.Schedule_AddTitle}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Report.Calendar}" />
            <TextBlock Text="{x:Static res:Strings.Register_Schedule}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ReconcileButton" Classes="tool" Command="{Binding StartReconcileCommand}" IsVisible="{Binding CanReconcile}"
                AutomationProperties.Name="{x:Static res:Strings.Register_Reconcile}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Reconcile}" />
            <TextBlock Text="{x:Static res:Strings.Register_Reconcile}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="RecordBalanceButton" Classes="tool" Command="{Binding RecordBalanceCommand}" IsVisible="{Binding IsTracking}"
                AutomationProperties.Name="{x:Static res:Strings.Register_RecordBalance}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Snapshot}" />
            <TextBlock Text="{x:Static res:Strings.Register_RecordBalance}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="EditAccountButton" Classes="tool" Command="{Binding EditAccountCommand}" IsVisible="{Binding !IsAllAccounts}"
                ToolTip.Tip="{x:Static res:Strings.Register_EditAccount}"
                AutomationProperties.Name="{x:Static res:Strings.Register_EditAccount}">
          <controls:Icon Data="{StaticResource Icon.Edit}" />
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageSubtitle" Text="{Binding Subtitle}" />
      </StackPanel>
    </DockPanel>

    <!-- Balances -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,16,0,0" IsVisible="{Binding !HasNoAccounts}">
      <Border Classes="tile" Margin="0,0,8,8">
        <StackPanel>
          <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.Register_WorkingBalance}" />
          <TextBlock x:Name="LedgerBalanceText" Classes="tileValue" Text="{Binding LedgerBalanceText}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,8,8">
        <StackPanel>
          <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.Register_ClearedBalance}" />
          <TextBlock x:Name="ClearedBalanceText" Classes="tileValue" Text="{Binding ClearedText}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,8,8">
        <StackPanel>
          <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.Register_UnclearedBalance}" />
          <TextBlock x:Name="UnclearedBalanceText" Classes="tileValue" Text="{Binding UnclearedText}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,8,8" IsVisible="{Binding HasReported}">
        <StackPanel>
          <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.Register_ReportedBalance}" />
          <TextBlock Classes="tileValue" Text="{Binding ReportedText}" />
          <TextBlock Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" IsVisible="{Binding ReportedMismatch}"
                     Text="{x:Static res:Strings.Register_ReportedMismatch}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,8,8" IsVisible="{Binding IsTracking}">
        <StackPanel>
          <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.Register_LatestSnapshot}" />
          <TextBlock Classes="tileValue" Text="{Binding SnapshotText}" IsVisible="{Binding HasSnapshot}" />
          <TextBlock Classes="secondary" Margin="0,4,0,0" Text="{x:Static res:Strings.Register_NoSnapshot}" IsVisible="{Binding !HasSnapshot}" />
        </StackPanel>
      </Border>
    </WrapPanel>

    <Border DockPanel.Dock="Top" Classes="warning" Margin="0,0,0,8" IsVisible="{Binding IsAccountClosed}">
      <TextBlock Text="{x:Static res:Strings.Register_Closed}" TextWrapping="Wrap" />
    </Border>

    <!-- Reconcile bar (F-ACC-3) -->
    <Border DockPanel.Dock="Top" x:Name="ReconcileBar" Classes="bar" Margin="0,0,0,8" IsVisible="{Binding IsReconciling}">
      <ContentControl Content="{Binding Reconcile}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="reg:ReconcileViewModel">
            <StackPanel Spacing="8">
              <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Reconcile_StatementDate}" />
                  <CalendarDatePicker SelectedDate="{Binding StatementDate}" Width="150"
                                      AutomationProperties.Name="{x:Static res:Strings.Reconcile_StatementDate}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Reconcile_StatementBalance}" />
                  <controls:MoneyTextBox x:Name="StatementBalanceBox" Width="150" Value="{Binding StatementBalance}" Currency="{Binding Currency}"
                                         ShowZeroAsEmpty="False" AutomationProperties.Name="{x:Static res:Strings.Reconcile_StatementBalance}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Reconcile_Cleared}" />
                  <TextBlock Classes="amount" FontSize="16" Margin="0,6,0,0" HorizontalAlignment="Left" Text="{Binding ClearedText}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Reconcile_Difference}" />
                  <TextBlock x:Name="DifferenceText" Classes="amount" Classes.negative="{Binding !IsBalanced}" FontSize="16" FontWeight="SemiBold"
                             Margin="0,6,0,0" HorizontalAlignment="Left" Text="{Binding DifferenceText}" />
                </StackPanel>
              </WrapPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding CancelCommand}" Content="{x:Static res:Strings.Reconcile_Cancel}" />
                  <Button x:Name="AdjustAndFinishButton" Command="{Binding FinishWithAdjustmentCommand}" IsVisible="{Binding !IsBalanced}"
                          Content="{x:Static res:Strings.Reconcile_FinishWithAdjustment}" />
                  <Button x:Name="FinishReconcileButton" Classes="accent" Command="{Binding FinishCommand}"
                          Content="{x:Static res:Strings.Reconcile_Finish}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding !IsBalanced}" Text="{x:Static res:Strings.Reconcile_Instructions}" />
                  <TextBlock TextWrapping="Wrap" IsVisible="{Binding IsBalanced}" Text="{x:Static res:Strings.Reconcile_Balanced}" />
                  <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- Filter bar -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8"
          IsVisible="{Binding !HasNoAccounts}">
      <TextBox x:Name="RegisterSearchBox" Text="{Binding SearchText}" Watermark="{x:Static res:Strings.Register_SearchWatermark}"
               AutomationProperties.Name="{x:Static res:Strings.Register_SearchName}">
        <TextBox.InnerLeftContent>
          <controls:Icon Data="{StaticResource Icon.Filter}" Width="14" Height="14" Margin="10,0,0,0"
                         Foreground="{DynamicResource Keel.TextSecondary}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <ComboBox Grid.Column="1" x:Name="DatePresetBox" MinWidth="130" ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedDatePreset}"
                AutomationProperties.Name="{x:Static res:Strings.Register_DateFilterName}" />
      <ComboBox Grid.Column="2" x:Name="StatusFilterBox" MinWidth="130" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"
                AutomationProperties.Name="{x:Static res:Strings.Register_StatusFilterName}" />
      <ComboBox Grid.Column="3" x:Name="CategoryFilterBox" MinWidth="160" MaxWidth="240" ItemsSource="{Binding CategoryFilters}"
                SelectedItem="{Binding SelectedCategoryFilter}" AutomationProperties.Name="{x:Static res:Strings.Register_CategoryFilterName}" />
      <ToggleButton Grid.Column="4" x:Name="UnapprovedToggle" IsChecked="{Binding UnapprovedOnly}"
                    Content="{x:Static res:Strings.Register_UnapprovedOnly}" />
      <Button Grid.Column="5" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
              Content="{x:Static res:Strings.Register_ClearFilters}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="0,-4,0,8" FontSize="{StaticResource Keel.FontSize.Small}"
               Text="{Binding SearchErrorText}" IsVisible="{Binding SearchErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Bulk actions for the selection -->
    <Border DockPanel.Dock="Top" x:Name="BulkBar" Classes="bar" Margin="0,0,0,8" IsVisible="{Binding HasSelection}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,16,0" />
        <WrapPanel>
          <Button Classes="tool" Margin="0,0,6,0" Command="{Binding CategorizeSelectedCommand}" Content="{x:Static res:Strings.Bulk_Categorize}" />
          <Button Classes="tool" Margin="0,0,6,0" Command="{Binding ApproveCommand}" Content="{x:Static res:Strings.Bulk_Approve}" />
          <Button Classes="tool" Margin="0,0,6,0" Command="{Binding MarkClearedCommand}" Content="{x:Static res:Strings.Bulk_Clear}" />
          <Button Classes="tool" Margin="0,0,6,0" Command="{Binding MarkUnclearedCommand}" Content="{x:Static res:Strings.Bulk_Unclear}" />
          <Button Classes="tool" Margin="0,0,6,0" Command="{Binding MoveSelectedCommand}" Content="{x:Static res:Strings.Bulk_Move}" />
          <Button Classes="tool" x:Name="BulkDeleteButton" Command="{Binding DeleteSelectedCommand}"
                  AutomationProperties.Name="{x:Static res:Strings.Bulk_Delete}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:Icon Data="{StaticResource Icon.Trash}" />
              <TextBlock Text="{x:Static res:Strings.Bulk_Delete}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Inline add/edit row (PRD 9.4) -->
    <Border DockPanel.Dock="Top" x:Name="EditorBar" Classes="editor" Margin="0,0,0,8" IsVisible="{Binding IsEditing}">
      <ContentControl x:Name="EditorHost" Content="{Binding Editor}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="reg:TransactionEditorViewModel">
            <StackPanel Spacing="6">
              <Grid x:Name="EditorGrid" Classes="editorRow" ColumnDefinitions="28,0,114,200,170,*,104,104,84,140" RowDefinitions="Auto">
                <ComboBox Grid.Column="1" x:Name="EditorAccount" Margin="4,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding Account}" IsVisible="{Binding CanChooseAccount}" IsEnabled="{Binding IsUnlocked}"
                          AutomationProperties.Name="{x:Static res:Strings.Editor_Account}" />
                <CalendarDatePicker Grid.Column="2" x:Name="EditorDate" Margin="4,0" HorizontalAlignment="Stretch"
                                    SelectedDate="{Binding Date}" IsEnabled="{Binding IsUnlocked}"
                                    AutomationProperties.Name="{x:Static res:Strings.Editor_Date}" />
                <AutoCompleteBox Grid.Column="3" x:Name="EditorPayee" Margin="4,0" Text="{Binding Payee}"
                                 AsyncPopulator="{Binding PayeePopulator}" MinimumPrefixLength="1" FilterMode="None"
                                 Watermark="{x:Static res:Strings.Editor_Payee}" AutomationProperties.Name="{x:Static res:Strings.Editor_Payee}" />
                <Panel Grid.Column="4" Margin="4,0">
                  <AutoCompleteBox x:Name="EditorCategory" Text="{Binding CategoryText}" SelectedItem="{Binding Category}"
                                   ItemsSource="{Binding Categories}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                   IsVisible="{Binding IsCategoryEnabled}"
                                   Watermark="{x:Static res:Strings.Editor_Category}" AutomationProperties.Name="{x:Static res:Strings.Editor_Category}" />
                  <TextBlock Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" TextWrapping="Wrap" VerticalAlignment="Center"
                             IsVisible="{Binding !IsCategoryEnabled}" Text="{x:Static res:Strings.Editor_CategoryNotNeeded}" />
                </Panel>
                <TextBox Grid.Column="5" x:Name="EditorMemo" Margin="4,0" Text="{Binding Memo}"
                         Watermark="{x:Static res:Strings.Editor_Memo}" AutomationProperties.Name="{x:Static res:Strings.Editor_Memo}" />
                <controls:MoneyTextBox Grid.Column="6" x:Name="EditorOutflow" Margin="4,0" Value="{Binding Outflow}" Currency="{Binding Currency}"
                                       IsEnabled="{Binding IsUnlocked}" Watermark="{x:Static res:Strings.Editor_Outflow}"
                                       AutomationProperties.Name="{x:Static res:Strings.Editor_Outflow}" />
                <controls:MoneyTextBox Grid.Column="7" x:Name="EditorInflow" Margin="4,0" Value="{Binding Inflow}" Currency="{Binding Currency}"
                                       IsEnabled="{Binding IsUnlocked}" Watermark="{x:Static res:Strings.Editor_Inflow}"
                                       AutomationProperties.Name="{x:Static res:Strings.Editor_Inflow}" />
                <CheckBox Grid.Column="8" x:Name="EditorCleared" HorizontalAlignment="Center" IsChecked="{Binding IsCleared}"
                          IsEnabled="{Binding IsUnlocked}" AutomationProperties.Name="{x:Static res:Strings.Editor_Cleared}"
                          ToolTip.Tip="{x:Static res:Strings.Editor_Cleared}" />
                <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" Margin="0,0,6,0">
                  <Button Command="{Binding SplitCommand}" IsVisible="{Binding CanSplit}" Padding="6"
                          ToolTip.Tip="{x:Static res:Strings.Editor_Split}" AutomationProperties.Name="{x:Static res:Strings.Editor_Split}">
                    <controls:Icon Data="{StaticResource Icon.Split}" Width="16" Height="16" />
                  </Button>
                  <Button x:Name="EditorSave" Classes="accent" Padding="8,6" Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).SaveCommand}"
                          ToolTip.Tip="{x:Static res:Strings.Editor_SaveHint}" Content="{x:Static res:Strings.Editor_Save}" />
                  <Button Padding="6" Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).CancelEditCommand}"
                          ToolTip.Tip="{x:Static res:Strings.Editor_Cancel}" AutomationProperties.Name="{x:Static res:Strings.Editor_Cancel}">
                    <controls:Icon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding Splits}" IsVisible="{Binding IsSplit}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="reg:SplitLineViewModel">
                    <Grid Classes="editorRow" ColumnDefinitions="28,0,114,200,170,*,104,104,84,140" Margin="0,2">
                      <controls:Icon Grid.Column="3" Data="{StaticResource Icon.Split}" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,8,0"
                                     Foreground="{DynamicResource Keel.TextSecondary}" />
                      <AutoCompleteBox Grid.Column="4" Margin="4,0" Text="{Binding CategoryText}" SelectedItem="{Binding Category}"
                                       ItemsSource="{Binding Categories}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                       Watermark="{x:Static res:Strings.Editor_Category}" AutomationProperties.Name="{x:Static res:Strings.Editor_Category}" />
                      <TextBox Grid.Column="5" Margin="4,0" Text="{Binding Memo}" Watermark="{x:Static res:Strings.Editor_Memo}"
                               AutomationProperties.Name="{x:Static res:Strings.Editor_Memo}" />
                      <controls:MoneyTextBox Grid.Column="6" Margin="4,0" Value="{Binding Outflow}"
                                             AutomationProperties.Name="{x:Static res:Strings.Editor_Outflow}" />
                      <controls:MoneyTextBox Grid.Column="7" Margin="4,0" Value="{Binding Inflow}"
                                             AutomationProperties.Name="{x:Static res:Strings.Editor_Inflow}" />
                      <Button Grid.Column="8" HorizontalAlignment="Center" Padding="4"
                              Command="{Binding $parent[ItemsControl].((reg:TransactionEditorViewModel)DataContext).RemoveSplitLineCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{x:Static res:Strings.Editor_RemoveSplitLine}" AutomationProperties.Name="{x:Static res:Strings.Editor_RemoveSplitLine}">
                        <controls:Icon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel Margin="32,0,8,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsSplit}">
                  <TextBlock Classes="amount" Classes.negative="{Binding !IsBalanced}" Text="{Binding RemainingText}" VerticalAlignment="Center" />
                  <Button Command="{Binding SplitCommand}" Content="{x:Static res:Strings.Editor_AddSplitLine}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                  <TextBlock Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" IsVisible="{Binding IsReconciled}"
                             Text="{x:Static res:Strings.Editor_Locked}" />
                  <TextBlock Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" Text="{x:Static res:Strings.Editor_SaveHint}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- Scheduled ghost rows (M5, F-ACC-6): upcoming instances, italic, with Enter now / Skip / Edit -->
    <Border DockPanel.Dock="Top" x:Name="GhostBar" Classes="ghostBar" Margin="0,0,0,8" IsVisible="{Binding Scheduled.HasRows, FallbackValue=False}">
      <StackPanel>
        <Button Classes="chartRow" Padding="8,2" Command="{Binding Scheduled.ToggleExpandedCommand, FallbackValue={x:Null}}"
                AutomationProperties.Name="{Binding Scheduled.HeaderText, FallbackValue=''}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Panel>
              <controls:Icon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" IsVisible="{Binding Scheduled.IsExpanded, FallbackValue=False}" />
              <controls:Icon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" IsVisible="{Binding !Scheduled.IsExpanded, FallbackValue=False}" />
            </Panel>
            <TextBlock Classes="sectionHeader" Text="{Binding Scheduled.HeaderText, FallbackValue=''}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ItemsControl x:Name="GhostRows" ItemsSource="{Binding Scheduled.Rows, FallbackValue={x:Null}}" IsVisible="{Binding Scheduled.IsExpanded, FallbackValue=False}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="bills:ScheduledInstanceRowViewModel">
              <Grid Classes="ghostRow" ColumnDefinitions="28,114,1.4*,1.2*,*,104,104,180" Height="30" AutomationProperties.Name="{Binding AutomationName}">
                <controls:Icon Data="{StaticResource Icon.Report.Calendar}" Width="13" Height="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Keel.TextSecondary}" ToolTip.Tip="{Binding StateText}" />
                <TextBlock Grid.Column="1" Classes="cell" Classes.overdue="{Binding IsOverdue}" Text="{Binding DateText}" FontFeatures="+tnum" ToolTip.Tip="{Binding StateText}" />
                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Payee}" />
                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Category}" />
                <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Memo}" />
                <TextBlock Grid.Column="5" Classes="cell amount" Text="{Binding Outflow}" />
                <TextBlock Grid.Column="6" Classes="cell amount" Text="{Binding Inflow}" />
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" Margin="8,0,6,0" HorizontalAlignment="Right">
                  <Button Classes="mini" IsVisible="{Binding IsNext}"
                          Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).Scheduled.EnterCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.Schedule_Enter}" />
                  <Button Classes="mini" IsVisible="{Binding IsNext}"
                          Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).Scheduled.SkipCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                          Content="{x:Static res:Strings.Schedule_Skip}" />
                  <Button Theme="{StaticResource IconButtonTheme}" MinWidth="24" MinHeight="22" Padding="4"
                          Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).Scheduled.EditCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                          ToolTip.Tip="{x:Static res:Strings.Schedule_EditTitle}" AutomationProperties.Name="{x:Static res:Strings.Schedule_EditTitle}">
                    <controls:Icon Data="{StaticResource Icon.Edit}" Width="12" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Footer: count and keyboard map -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="{Binding !HasNoAccounts}">
      <TextBlock DockPanel.Dock="Left" x:Name="RowCountLabel" Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" Text="{Binding RowCountText}" />
      <TextBlock Classes="secondary" FontSize="{StaticResource Keel.FontSize.Small}" HorizontalAlignment="Right"
                 Text="{x:Static res:Strings.Register_KeyHints}" />
    </DockPanel>

    <!-- Content: grid, empty, loading, error -->
    <Panel>
      <DataGrid x:Name="RegisterGrid" Classes="register" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowGrid}"
                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True"
                CanUserReorderColumns="False" CanUserResizeColumns="True" RowDetailsVisibilityMode="Collapsed"
                AutomationProperties.Name="{Binding Title}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="28" CanUserSort="False" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <Panel>
                  <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource Keel.Accent}" IsVisible="{Binding IsUnapproved}"
                          ToolTip.Tip="{x:Static res:Strings.Register_Unapproved}" />
                  <ToggleButton Theme="{StaticResource IconButtonTheme}" MinWidth="20" MinHeight="20" Padding="2" IsVisible="{Binding IsSplit}"
                                Classes="expander" IsChecked="{Binding IsExpanded, Mode=OneWay}" Focusable="False"
                                ToolTip.Tip="{x:Static res:Strings.Register_ExpandSplit}" AutomationProperties.Name="{x:Static res:Strings.Register_ExpandSplit}">
                    <Panel>
                      <controls:Icon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" IsVisible="{Binding !IsExpanded}" />
                      <controls:Icon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" IsVisible="{Binding IsExpanded}" />
                    </Panel>
                  </ToggleButton>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Account}" Width="0.9*" MinWidth="110" SortMemberPath="Account">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell" Text="{Binding AccountName}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Date}" Width="114" SortMemberPath="Date">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell" Text="{Binding DateText}" FontFeatures="+tnum" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Payee}" Width="1.4*" MinWidth="140" SortMemberPath="Payee">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <DockPanel Margin="8,0,0,0">
                  <controls:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Transfer}" Width="14" Height="14" Margin="0,0,6,0"
                                 IsVisible="{Binding IsTransfer}" Foreground="{DynamicResource Keel.TextSecondary}" />
                  <TextBlock Classes="cell" Margin="0,0,8,0" Text="{Binding Payee}" />
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Category}" Width="1.2*" MinWidth="120" SortMemberPath="Category">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell" Classes.muted="{Binding IsUncategorized}" Text="{Binding Category}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Memo}" Width="*" MinWidth="80" SortMemberPath="Memo">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell" Classes.secondary="True" Text="{Binding Memo}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Outflow}" Width="104" SortMemberPath="Amount">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell amount" Text="{Binding Outflow}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Inflow}" Width="104" SortMemberPath="Amount">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell amount" Text="{Binding Inflow}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Cleared}" Width="84" SortMemberPath="Status" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <Button Theme="{StaticResource IconButtonTheme}" MinWidth="24" MinHeight="24" Padding="3" HorizontalAlignment="Center"
                        Focusable="False" IsVisible="{Binding IsLoaded}"
                        Command="{Binding $parent[DataGrid].((vm:AccountsViewModel)DataContext).ToggleRowClearedCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding StatusName}" AutomationProperties.Name="{Binding StatusName}">
                  <Panel>
                    <controls:Icon Data="{StaticResource Icon.Circle}" Width="15" Height="15" IsVisible="{Binding IsUncleared}"
                                   Foreground="{DynamicResource Keel.TextSecondary}" />
                    <controls:Icon Data="{StaticResource Icon.CheckCircle}" Width="16" Height="16" IsVisible="{Binding IsCleared}"
                                   Foreground="{DynamicResource Keel.Positive}" />
                    <controls:Icon Data="{StaticResource Icon.Lock}" Width="15" Height="15" IsVisible="{Binding IsReconciled}"
                                   Foreground="{DynamicResource Keel.Accent}" />
                  </Panel>
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Balance}" Width="140" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="reg:RegisterRowViewModel">
                <TextBlock Classes="cell amount" Classes.negative="{Binding IsNegativeBalance}" Text="{Binding RunningBalance}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="CreateRuleMenuItem" Header="{x:Static res:Strings.Rules_CreateFromTransaction}"
                      Command="{Binding CreateRuleFromTransactionCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.RowDetailsTemplate>
          <DataTemplate x:DataType="reg:RegisterRowViewModel">
            <ItemsControl ItemsSource="{Binding Splits}" Margin="0,0,0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="reg:SplitRowViewModel">
                  <Grid Classes="editorRow" ColumnDefinitions="28,0,114,200,170,*,104,104,84,140" Height="26">
                    <controls:Icon Grid.Column="3" Data="{StaticResource Icon.Split}" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Keel.TextSecondary}" />
                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Category}" />
                    <TextBlock Grid.Column="5" Classes="cell secondary" Text="{Binding Memo}" />
                    <TextBlock Grid.Column="6" Classes="cell amount" Text="{Binding Outflow}" />
                    <TextBlock Grid.Column="7" Classes="cell amount" Text="{Binding Inflow}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </DataGrid.RowDetailsTemplate>
      </DataGrid>

      <controls:EmptyState Icon="{StaticResource Icon.Accounts}" Heading="{Binding EmptyHeading}" Message="{Binding EmptyMessage}"
                           IsVisible="{Binding ShowEmptyState}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Command="{Binding NewTransactionCommand}" IsVisible="{Binding CanAddTransaction}"
                  Content="{x:Static res:Strings.Register_AddTransaction}" />
          <Button Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                  Content="{x:Static res:Strings.Register_ClearFilters}" />
        </StackPanel>
      </controls:EmptyState>

      <ProgressBar IsIndeterminate="True" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsLoading}" />

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding HasError}" MaxWidth="460">
        <TextBlock Classes="error" TextAlignment="Center" Text="{Binding ErrorMessage}" />
        <Button HorizontalAlignment="Center" Command="{Binding RetryCommand}" Content="{x:Static res:Strings.Register_Retry}" />
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
