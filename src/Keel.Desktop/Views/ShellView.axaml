<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Keel.Desktop.ViewModels"
             xmlns:controls="using:Keel.Desktop.Controls"
             xmlns:conv="using:Keel.Desktop.Converters"
             xmlns:res="using:Keel.Desktop.Resources"
             xmlns:dlg="using:Keel.Desktop.ViewModels.Dialogs"
             xmlns:syncviews="using:Keel.Desktop.Views.Sync"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Keel.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:NavigationItemViewModel">
      <RadioButton Theme="{StaticResource NavItemTheme}"
                   GroupName="ShellNavigation"
                   IsChecked="{Binding IsSelected, Mode=OneWay}"
                   Command="{Binding NavigateCommand}"
                   AutomationProperties.Name="{Binding Title}"
                   ToolTip.Tip="{Binding Title}">
        <DockPanel>
          <controls:Icon DockPanel.Dock="Left"
                         Data="{Binding IconKey, Converter={x:Static conv:ResourceConverters.Geometry}}" />
          <Border DockPanel.Dock="Right" Classes="badge navLabel" IsVisible="{Binding HasBadge}">
            <TextBlock Text="{Binding Badge}" />
          </Border>
          <TextBlock Classes="navLabel" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </RadioButton>
    </DataTemplate>
    <DataTemplate DataType="vm:SidebarAccountViewModel">
      <RadioButton Theme="{StaticResource NavItemTheme}"
                   GroupName="ShellNavigation" Padding="11,6"
                   IsChecked="{Binding IsSelected, Mode=OneWay}"
                   Command="{Binding NavigateCommand}"
                   AutomationProperties.Name="{Binding AutomationName}"
                   ToolTip.Tip="{Binding AutomationName}">
        <RadioButton.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static res:Strings.Nav_EditAccount}" Command="{Binding EditCommand}" />
            <MenuItem Header="{x:Static res:Strings.Nav_ImportFile}" Command="{Binding ImportFileCommand}" />
            <MenuItem Header="{x:Static res:Strings.Nav_MoveUp}" Command="{Binding MoveUpCommand}" />
            <MenuItem Header="{x:Static res:Strings.Nav_MoveDown}" Command="{Binding MoveDownCommand}" />
          </ContextMenu>
        </RadioButton.ContextMenu>
        <DockPanel>
          <controls:Icon DockPanel.Dock="Left" Width="16" Height="16"
                         Data="{Binding IconKey, Converter={x:Static conv:ResourceConverters.Geometry}}" />
          <TextBlock DockPanel.Dock="Right" Classes="accountBalance navLabel" Classes.negative="{Binding IsNegative}"
                     Text="{Binding BalanceText}" Margin="8,0,0,0" />
          <Panel DockPanel.Dock="Right" Classes="navLabel" Margin="6,0,0,0" IsVisible="{Binding IsLinked}"
                 ToolTip.Tip="{Binding HealthToolTip}">
            <Ellipse Classes="health" IsVisible="{Binding !IsSyncing}"
                     Classes.ok="{Binding Health, Converter={x:Static syncviews:HealthKindConverter.Instance}, ConverterParameter=Ok}"
                     Classes.attention="{Binding Health, Converter={x:Static syncviews:HealthKindConverter.Instance}, ConverterParameter=Attention}"
                     Classes.error="{Binding Health, Converter={x:Static syncviews:HealthKindConverter.Instance}, ConverterParameter=Error}" />
            <controls:Icon Classes="spin" Data="{StaticResource Icon.Sync}" Width="10" Height="10" IsVisible="{Binding IsSyncing}"
                           Foreground="{DynamicResource Keel.TextSecondary}" />
          </Panel>
          <TextBlock Classes="navLabel" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </RadioButton>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
  <DockPanel>
  <!-- In-window menu bar (Windows, Linux; macOS uses the native menu, PRD 8). Built in code from AppCommands. -->
  <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static res:Strings.Menu_Bar}" />
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Top bar -->
    <Border Grid.Row="0" Background="{DynamicResource Keel.SurfaceBackground}"
            BorderBrush="{DynamicResource Keel.BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Theme="{StaticResource IconButtonTheme}" Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{Binding ToggleSidebarToolTip}"
                AutomationProperties.Name="{x:Static res:Strings.Shell_ToggleSidebar}">
          <controls:Icon Data="{StaticResource Icon.Menu}" />
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,24,0" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding FilePath}">
          <controls:Icon Data="{StaticResource Icon.File}" Width="16" Height="16"
                         Foreground="{DynamicResource Keel.TextSecondary}" />
          <TextBlock x:Name="FileNameText" Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center"
                     MaxWidth="260" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBox Grid.Column="2" x:Name="SearchBox" HorizontalAlignment="Center" Width="360" VerticalAlignment="Center"
                 Watermark="{Binding SearchWatermark}" Text="{Binding SearchText}"
                 AutomationProperties.Name="{x:Static res:Strings.Shell_SearchName}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
          <TextBox.InnerLeftContent>
            <controls:Icon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="10,0,0,0"
                           Foreground="{DynamicResource Keel.TextSecondary}" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
          <Button Theme="{StaticResource IconButtonTheme}" Command="{Binding UndoCommand}"
                  ToolTip.Tip="{Binding UndoToolTip}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{x:Static res:Strings.Shell_Undo}">
            <controls:Icon Data="{StaticResource Icon.Undo}" />
          </Button>
          <Button Theme="{StaticResource IconButtonTheme}" Command="{Binding RedoCommand}"
                  ToolTip.Tip="{Binding RedoToolTip}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{x:Static res:Strings.Shell_Redo}">
            <controls:Icon Data="{StaticResource Icon.Redo}" />
          </Button>
          <Button x:Name="SyncAllButton" Theme="{StaticResource IconButtonTheme}" Command="{Binding SyncAllCommand}" Margin="8,0,0,0"
                  ToolTip.Tip="{Binding SyncToolTip}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{Binding SyncAllLabel}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Sync}" Width="16" Height="16" Classes.spin="{Binding Sync.IsSyncing}" />
              <TextBlock Text="{Binding SyncAllLabel}" VerticalAlignment="Center" />
              <TextBlock x:Name="LastSyncText" Classes="secondary" Text="{Binding Sync.LastSyncText}" VerticalAlignment="Center"
                         FontSize="{StaticResource Keel.FontSize.Small}" IsVisible="{Binding Sync.HasConnections}" />
            </StackPanel>
          </Button>
          <Button x:Name="BellButton" Theme="{StaticResource IconButtonTheme}" Command="{Binding Notifications.ToggleCommand, FallbackValue={x:Null}}"
                  IsEnabled="{Binding Notifications, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding AlertsToolTip}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{Binding Notifications.BellName, FallbackValue={x:Static res:Strings.Shell_Alerts}}">
            <Panel>
              <controls:Icon Data="{StaticResource Icon.Bell}" />
              <Border x:Name="BellBadge" Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-10,0"
                      IsVisible="{Binding Notifications.HasUnread, FallbackValue=False}">
                <TextBlock Text="{Binding Notifications.BadgeText, FallbackValue=''}" />
              </Border>
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar and content -->
    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="232,Auto,*">
      <Border Grid.Column="0" x:Name="Sidebar" Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}"
              Background="{DynamicResource Keel.SidebarBackground}"
              BorderBrush="{DynamicResource Keel.BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="8,12,8,12">
          <ContentControl DockPanel.Dock="Bottom" Content="{Binding SettingsItem}" Margin="0,8,0,0" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="2" AutomationProperties.Name="{x:Static res:Strings.Nav_Primary}">
              <ItemsControl ItemsSource="{Binding PrimaryItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Classes="sectionHeader navLabel" Text="{x:Static res:Strings.Nav_Accounts}" Margin="11,20,0,6" />
              <ItemsControl ItemsSource="{Binding AccountItems}" />
              <TextBlock Classes="secondary navLabel" Text="{x:Static res:Strings.Nav_NoAccounts}" Margin="41,6,8,0"
                         FontSize="{StaticResource Keel.FontSize.Small}" IsVisible="{Binding !HasAccounts}" />
              <ItemsControl x:Name="AccountGroupList" ItemsSource="{Binding AccountGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:SidebarAccountGroupViewModel">
                    <StackPanel Spacing="2" Margin="0,10,0,0">
                      <DockPanel Margin="11,0,8,2">
                        <TextBlock DockPanel.Dock="Right" Classes="accountBalance navLabel" Text="{Binding TotalText}" />
                        <TextBlock Classes="sectionHeader navLabel" Text="{Binding Title}" />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Accounts}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="AddAccountButton" Classes="navLabel" Theme="{StaticResource IconButtonTheme}" Margin="4,8,0,0" HorizontalAlignment="Left"
                      Command="{Binding AddAccountCommand}" AutomationProperties.Name="{x:Static res:Strings.Nav_AddAccount}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                  <TextBlock Text="{x:Static res:Strings.Nav_AddAccount}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <CheckBox Classes="navLabel" Margin="12,4,0,0" IsVisible="{Binding HasClosedAccounts}"
                        IsChecked="{Binding ShowClosedAccounts}" Content="{x:Static res:Strings.Nav_ShowClosed}"
                        FontSize="{StaticResource Keel.FontSize.Small}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Invisible 4-px drag handle over the sidebar's right border. -->
      <GridSplitter Grid.Column="1" x:Name="SidebarSplitter" Width="4" MinWidth="4" Margin="-4,0,0,0"
                    ResizeDirection="Columns" Background="Transparent"
                    IsVisible="{Binding !IsSidebarCollapsed}" />

      <ContentControl Grid.Column="2" x:Name="PageHost" Content="{Binding CurrentPage}" />

      <!-- Notification center (M5): a panel under the bell; a click outside closes it. -->
      <Panel Grid.Column="0" Grid.ColumnSpan="3" x:Name="NotificationLayer" IsVisible="{Binding Notifications.IsOpen, FallbackValue=False}">
        <Border x:Name="NotificationDismissArea" Background="Transparent" />
        <Border Classes="notificationPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" Width="400" MaxHeight="560">
          <ContentControl x:Name="NotificationHost" Content="{Binding Notifications}" />
        </Border>
      </Panel>

      <!-- Modal dialog layer -->
      <Border Grid.Column="0" Grid.ColumnSpan="3" x:Name="DialogLayer" Background="{DynamicResource Keel.Scrim}"
              IsVisible="{Binding Dialogs.Current, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420"
                MaxWidth="{Binding Dialogs.CurrentMaxWidth}">
          <ContentControl x:Name="DialogHost" Content="{Binding Dialogs.Current}" />
        </Border>
      </Border>
    </Grid>

    <!-- Status strip -->
    <Border Grid.Row="2" Background="{DynamicResource Keel.SurfaceBackground}"
            BorderBrush="{DynamicResource Keel.BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <controls:Icon Data="{StaticResource Icon.Lock}" Width="12" Height="12"
                         Foreground="{DynamicResource Keel.TextSecondary}" />
          <TextBlock Classes="secondary" Text="{Binding LocalOnlyText}" FontSize="{StaticResource Keel.FontSize.Small}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button DockPanel.Dock="Left" x:Name="StatusUndoButton" Theme="{StaticResource IconButtonTheme}"
                MinHeight="20" Padding="8,0" Margin="0,0,8,0" IsVisible="{Binding Status.CanUndo}"
                Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoToolTip}"
                AutomationProperties.Name="{x:Static res:Strings.Shell_StatusUndo}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <controls:Icon Data="{StaticResource Icon.Undo}" Width="12" Height="12" />
            <TextBlock Text="{x:Static res:Strings.Shell_StatusUndo}" FontSize="{StaticResource Keel.FontSize.Small}"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="StatusText" Classes="secondary" Classes.error="{Binding Status.IsError}" Text="{Binding StatusMessage}"
                   FontSize="{StaticResource Keel.FontSize.Small}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
  </DockPanel>

  <!-- First-run setup (PRD 9.10) over the whole window. -->
  <ContentControl x:Name="FirstRunHost" Content="{Binding FirstRun}" IsVisible="{Binding IsFirstRunVisible}" />
  </Panel>
</UserControl>
