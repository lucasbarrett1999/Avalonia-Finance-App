<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keel.Desktop.ViewModels"
             xmlns:controls="using:Keel.Desktop.Controls"
             xmlns:res="using:Keel.Desktop.Resources"
             xmlns:rulesViews="using:Keel.Desktop.Views.Rules"
             x:Class="Keel.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel Margin="{StaticResource Keel.PagePadding}">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
      <TextBlock Classes="pageTitle" Text="{Binding Title}" />
      <TextBlock Classes="pageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>
    <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

        <!-- General: budget file, backups, integrity, diagnostics (F-SET-1) -->
        <Border Classes="card" x:Name="GeneralSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.File}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Settings_General}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <ContentControl x:Name="DataFileHost" Content="{Binding DataFile}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Lock}" Width="14" Height="14"
                             Foreground="{DynamicResource Keel.TextSecondary}" />
              <TextBlock Classes="secondary" Text="{x:Static res:Strings.Settings_Privacy}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Appearance (F-SET-2) -->
        <Border Classes="card" x:Name="AppearanceSection">
          <StackPanel Spacing="12">
            <TextBlock Text="{x:Static res:Strings.Settings_Appearance}" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Classes="secondary" Text="{x:Static res:Strings.Settings_Theme}" />
            <StackPanel Orientation="Horizontal" Spacing="24">
              <RadioButton x:Name="ThemeSystem" GroupName="Theme" IsChecked="{Binding IsSystemTheme}"
                           AutomationProperties.Name="{x:Static res:Strings.Settings_ThemeSystem}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:Icon Data="{StaticResource Icon.Monitor}" Width="16" Height="16" />
                  <TextBlock Text="{x:Static res:Strings.Settings_ThemeSystem}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeLight" GroupName="Theme" IsChecked="{Binding IsLightTheme}"
                           AutomationProperties.Name="{x:Static res:Strings.Settings_ThemeLight}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:Icon Data="{StaticResource Icon.Sun}" Width="16" Height="16" />
                  <TextBlock Text="{x:Static res:Strings.Settings_ThemeLight}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeDark" GroupName="Theme" IsChecked="{Binding IsDarkTheme}"
                           AutomationProperties.Name="{x:Static res:Strings.Settings_ThemeDark}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:Icon Data="{StaticResource Icon.Moon}" Width="16" Height="16" />
                  <TextBlock Text="{x:Static res:Strings.Settings_ThemeDark}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
            <ContentControl x:Name="AppearanceExtras" Content="{Binding AppearanceExtras}" />
          </StackPanel>
        </Border>


        <!-- Connections (F-SET-3) -->
        <ContentControl x:Name="ConnectionsSection" Content="{Binding Connections}" />

        <!-- Bills and subscriptions (F-REC-2) -->
        <Border Classes="card" x:Name="BillsSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Bills}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Settings_BillsTitle}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <ContentControl x:Name="BillsSettingsHost" Content="{Binding Bills}" />
          </StackPanel>
        </Border>
        <!-- Tags (F-TXN-8) -->
        <Border Classes="card" x:Name="TagsSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Tag}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Tag_SettingsTitle}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <ContentControl x:Name="TagsSettingsHost" Content="{Binding Tags}" />
          </StackPanel>
        </Border>

        <!-- Payees (F-TXN-9) -->
        <Border Classes="card" x:Name="PayeesSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Accounts}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Settings_Payees}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <rulesViews:PayeesPanel x:Name="PayeesPanel" DataContext="{Binding Payees}" />
          </StackPanel>
        </Border>

        <!-- Rules (F-TXN-4) -->
        <Border Classes="card" x:Name="RulesSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Filter}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Settings_Rules}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="{Binding Rules.Subtitle}" TextWrapping="Wrap" />
            <rulesViews:RulesPanel x:Name="RulesPanel" DataContext="{Binding Rules}" />
          </StackPanel>
        </Border>

        <!-- Keyboard shortcuts (F-SET-5), generated from the shortcut registry -->
        <Border Classes="card" x:Name="KeyboardSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Keyboard}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Settings_Shortcuts}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <ItemsControl x:Name="ShortcutGroupList" ItemsSource="{Binding ShortcutGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ShortcutGroupViewModel">
                  <StackPanel Margin="0,4,0,8">
                    <TextBlock Classes="sectionHeader" Text="{Binding Title}" Margin="0,4,0,4" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ShortcutViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <TextBlock Text="{Binding Action}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Classes="keycap">
                              <TextBlock Text="{Binding Keys}" FontSize="{StaticResource Keel.FontSize.Small}" />
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Updates (PRD 10: off by default) -->
        <Border Classes="card" x:Name="UpdatesSection">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Data="{StaticResource Icon.Sync}" Width="18" Height="18" />
              <TextBlock Text="{x:Static res:Strings.Settings_UpdatesTitle}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <ContentControl x:Name="UpdatesHost" Content="{Binding Updates}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
