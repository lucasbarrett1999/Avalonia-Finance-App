<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keel.Desktop.ViewModels"
             xmlns:b="using:Keel.Desktop.ViewModels.Budget"
             xmlns:controls="using:Keel.Desktop.Controls"
             xmlns:res="using:Keel.Desktop.Resources"
             xmlns:bv="using:Keel.Desktop.Views.Budget"
             x:Class="Keel.Desktop.Views.BudgetView"
             x:DataType="vm:BudgetViewModel">
  <UserControl.Styles>
    <!-- Narrow windows (a small screen, or 200% scaling on a 1080p display): the Ready to Assign pill moves
         under the month, and the inspector floats over the grid instead of squeezing it (BudgetView.axaml.cs). -->
    <Style Selector="Button#ReadyToAssignPill">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style Selector=":is(UserControl).narrowHeader Button#ReadyToAssignPill">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="StackPanel#BudgetActions">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="2" />
    </Style>
    <Style Selector=":is(UserControl).narrowHeader StackPanel#BudgetActions">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <!-- With the view toggles the actions no longer fit next to the pill at 960 px: icons only (names and tooltips stay). -->
    <Style Selector=":is(UserControl).compactActions StackPanel#BudgetActions TextBlock.toolLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ContentControl#InspectorHost">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="16,16,0,0" />
    </Style>
    <Style Selector=":is(UserControl).overlayInspector ContentControl#InspectorHost Border.inspector">
      <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
    </Style>
    <Style Selector=":is(UserControl).overlayInspector ContentControl#InspectorHost">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="{StaticResource Keel.PagePadding}">
    <!-- Header: month picker, Ready to Assign, quick actions (PRD 9.3) -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="-8,2,0,0">
          <Button x:Name="PreviousMonthButton" Theme="{StaticResource IconButtonTheme}" Command="{Binding PreviousMonthCommand}"
                  ToolTip.Tip="{Binding PreviousMonthTip}" AutomationProperties.Name="{x:Static res:Strings.Budget_PreviousMonth}">
            <controls:Icon Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" />
          </Button>
          <Button x:Name="MonthPickerButton" Classes="monthButton" ToolTip.Tip="{x:Static res:Strings.Budget_JumpToMonth}"
                  AutomationProperties.Name="{x:Static res:Strings.Budget_JumpToMonth}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="MonthTitleText" Text="{Binding MonthTitle}" FontSize="{StaticResource Keel.FontSize.Heading}" FontWeight="SemiBold"
                         VerticalAlignment="Center" MinWidth="150" />
              <controls:Icon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel x:Name="MonthPickerPanel" Spacing="8" Width="240">
                  <DockPanel>
                    <Button DockPanel.Dock="Left" Theme="{StaticResource IconButtonTheme}" Command="{Binding PickerPreviousYearCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.Budget_PreviousYear}">
                      <controls:Icon Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" />
                    </Button>
                    <Button DockPanel.Dock="Right" Theme="{StaticResource IconButtonTheme}" Command="{Binding PickerNextYearCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.Budget_NextYear}">
                      <controls:Icon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" />
                    </Button>
                    <TextBlock Text="{Binding PickerYear}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </DockPanel>
                  <ItemsControl x:Name="PickerMonthList" ItemsSource="{Binding PickerMonths}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MonthChoice">
                        <Button Classes="monthChoice" Classes.current="{Binding IsCurrent}" Content="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:BudgetViewModel)DataContext).PickMonthCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="NextMonthButton" Theme="{StaticResource IconButtonTheme}" Command="{Binding NextMonthCommand}"
                  ToolTip.Tip="{Binding NextMonthTip}" AutomationProperties.Name="{x:Static res:Strings.Budget_NextMonth}">
            <controls:Icon Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16" />
          </Button>
          <Button x:Name="TodayButton" Classes="tool" Margin="8,0,0,0" Command="{Binding GoToTodayCommand}" IsEnabled="{Binding !IsThisMonth}"
                  Content="{x:Static res:Strings.Budget_Today}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <Button x:Name="ReadyToAssignPill" Classes="rtaPill" Classes.negative="{Binding IsReadyToAssignNegative}"
              VerticalAlignment="Center" IsVisible="{Binding ShowHeader}" DragDrop.AllowDrop="True"
              Command="{Binding ExplainReadyToAssignCommand}" ToolTip.Tip="{x:Static res:Strings.Budget_RtaTip}"
              AutomationProperties.Name="{x:Static res:Strings.Budget_ReadyToAssign}"
              AutomationProperties.HelpText="{Binding ReadyToAssignText}">
        <StackPanel>
          <TextBlock x:Name="ReadyToAssignText" Classes="rtaAmount" Text="{Binding ReadyToAssignText}" />
          <TextBlock Classes="rtaLabel" Text="{x:Static res:Strings.Budget_ReadyToAssign}" />
        </StackPanel>
      </Button>

      <StackPanel x:Name="BudgetActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
        <Button x:Name="FundTargetsButton" Classes="tool accent" Command="{Binding FundTargetsCommand}" ToolTip.Tip="{Binding FundTargetsTip}"
                IsEnabled="{Binding ShowGrid}" AutomationProperties.Name="{x:Static res:Strings.Budget_FundTargets}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Zap}" />
            <TextBlock Classes="toolLabel" Text="{x:Static res:Strings.Budget_FundTargets}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="MoveMoneyButton" Classes="tool" Command="{Binding MoveMoneyCommand}" ToolTip.Tip="{Binding MoveMoneyTip}"
                IsEnabled="{Binding ShowGrid}" AutomationProperties.Name="{x:Static res:Strings.Budget_MoveMoney}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Transfer}" />
            <TextBlock Classes="toolLabel" Text="{x:Static res:Strings.Budget_MoveMoney}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="BudgetUndoButton" Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{x:Static res:Strings.Shell_Undo}">
          <controls:Icon Data="{StaticResource Icon.Undo}" />
        </Button>
        <Button x:Name="ManageCategoriesButton" Classes="tool" Command="{Binding ManageCategoriesCommand}"
                ToolTip.Tip="{x:Static res:Strings.Budget_ManageCategories}" AutomationProperties.Name="{x:Static res:Strings.Budget_ManageCategories}">
          <controls:Icon Data="{StaticResource Icon.List}" />
        </Button>
        <ToggleButton x:Name="ThreeMonthsToggle" Classes="tool" IsChecked="{Binding IsThreeMonths, Mode=OneWay}" Command="{Binding ToggleThreeMonthsCommand}"
                      ToolTip.Tip="{Binding ThreeMonthsTip}" MinHeight="32" Padding="10,6" IsEnabled="{Binding ShowGrid}"
                      AutomationProperties.Name="{x:Static res:Strings.BudgetMonths_Toggle}">
          <controls:Icon Data="{StaticResource Icon.Columns}" Width="16" Height="16" />
        </ToggleButton>
        <ToggleButton x:Name="FlexViewToggle" Classes="tool" IsChecked="{Binding IsFlexView, Mode=OneWay}" Command="{Binding ToggleFlexViewCommand}"
                      ToolTip.Tip="{Binding FlexViewTip}" MinHeight="32" Padding="10,6" IsEnabled="{Binding ShowGrid}"
                      AutomationProperties.Name="{x:Static res:Strings.Flex_Toggle}">
          <controls:Icon Data="{StaticResource Icon.Gauge}" Width="16" Height="16" />
        </ToggleButton>
        <ToggleButton x:Name="InspectorToggle" Classes="tool" IsChecked="{Binding IsInspectorOpen}" ToolTip.Tip="{Binding InspectorTip}"
                      MinHeight="32" Padding="10,6" AutomationProperties.Name="{x:Static res:Strings.Budget_Inspector}">
          <controls:Icon Data="{StaticResource Icon.Inspector}" Width="16" Height="16" />
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- Month totals (6.4.3) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0" IsVisible="{Binding ShowHeader}">
      <TextBlock x:Name="TotalsText" Classes="secondary" Text="{Binding TotalsText}" FontFeatures="+tnum" />
      <TextBlock Classes="secondary" Text="{Binding AssignedInFutureText}" IsVisible="{Binding HasAssignedInFuture}" FontFeatures="+tnum" />
    </StackPanel>

    <!-- "You've assigned more than you have" (F-BUD-2) -->
    <Border DockPanel.Dock="Top" x:Name="OverAssignedBanner" Classes="overBanner" Margin="0,12,0,0"
            IsVisible="{Binding IsReadyToAssignNegative}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:Icon Data="{StaticResource Icon.Alert}" Width="16" Height="16" />
        <TextBlock Text="{x:Static res:Strings.Budget_OverAssigned}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{x:Static res:Strings.Budget_OverAssignedHelp}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="warning" Margin="0,12,0,0" IsVisible="{Binding HasUncategorized}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:Icon Data="{StaticResource Icon.Info}" Width="14" Height="14" Foreground="{DynamicResource Keel.Warning}" />
        <TextBlock Text="{Binding UncategorizedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto">
    <!-- Inspector (I) -->
    <ContentControl x:Name="InspectorHost" Width="340" ZIndex="1"
                    Content="{Binding Inspector}" IsVisible="{Binding IsInspectorOpen}" />

    <Panel Grid.Column="0" Margin="0,16,0,0" MinWidth="520">
      <!-- Loading -->
      <StackPanel x:Name="LoadingState" IsVisible="{Binding ShowLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="220" />
        <TextBlock Classes="secondary" Text="{x:Static res:Strings.Budget_Loading}" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Error -->
      <StackPanel x:Name="ErrorState" IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
        <controls:Icon Data="{StaticResource Icon.Alert}" Width="32" Height="32" HorizontalAlignment="Center" Foreground="{DynamicResource Keel.Negative}" />
        <TextBlock Text="{x:Static res:Strings.Budget_ErrorHeading}" FontSize="{StaticResource Keel.FontSize.Heading}" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding RetryCommand}" Content="{x:Static res:Strings.Budget_Retry}" />
      </StackPanel>

      <!-- Empty: no categories yet (F-BUD-1, F-BUD-8) -->
      <controls:EmptyState x:Name="BudgetEmptyState" IsVisible="{Binding ShowEmptyState}" Icon="{StaticResource Icon.Budget}"
                           Heading="{Binding EmptyHeading}" Message="{Binding EmptyMessage}">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Button x:Name="EmptyManageButton" Classes="accent" HorizontalAlignment="Center" Command="{Binding ManageCategoriesCommand}"
                  Content="{x:Static res:Strings.Budget_ManageCategories}" />
          <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{x:Static res:Strings.Budget_EmptyTemplates}" />
          <ItemsControl x:Name="TemplateList" ItemsSource="{Binding Templates}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="b:BudgetTemplate">
                <Button Content="{Binding Name}" ToolTip.Tip="{Binding Preview}" AutomationProperties.Name="{Binding AutomationName}"
                        Command="{Binding $parent[ItemsControl].((vm:BudgetViewModel)DataContext).ApplyTemplateCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:EmptyState>

      <!-- The grid: group rows and category rows (custom hierarchical grid, ADR 0040); one month, or three side by side (ADR 0090) -->
      <Border x:Name="GridHost" Classes="budgetTable" IsVisible="{Binding ShowTable}" Focusable="True" FocusAdorner="{x:Null}"
              AutomationProperties.Name="{x:Static res:Strings.Budget_GridName}">
        <DockPanel>
          <!-- Flex-view drill-down filter -->
          <Border DockPanel.Dock="Top" x:Name="FlexFilterBanner" Classes="flexFilter" IsVisible="{Binding HasFlexFilter}">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ClearFlexFilterButton" Classes="tool" Command="{Binding ClearFlexFilterCommand}"
                      Content="{x:Static res:Strings.Flex_ClearFilter}" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:Icon Data="{StaticResource Icon.Gauge}" Width="14" Height="14" />
                <TextBlock x:Name="FlexFilterText" Text="{Binding FlexFilterText}" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- Scrolls sideways in three-month mode when the window is narrow (960 × 540 at 200%) -->
          <ScrollViewer x:Name="GridHScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <DockPanel x:Name="GridTable">
              <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Keel.BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8" IsVisible="{Binding !IsThreeMonths}">
                <Grid ColumnDefinitions="*,124,124,136" Margin="0,0,12,0">
                  <TextBlock Grid.Column="0" Classes="columnHeader" Margin="44,0,0,0" Text="{x:Static res:Strings.Budget_ColumnCategory}" />
                  <TextBlock Grid.Column="1" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{x:Static res:Strings.Budget_ColumnAssigned}" />
                  <TextBlock Grid.Column="2" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{x:Static res:Strings.Budget_ColumnActivity}" />
                  <TextBlock Grid.Column="3" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{x:Static res:Strings.Budget_ColumnAvailable}" />
                </Grid>
              </Border>
              <!-- Three-month header: each month with its Ready to Assign (6.4.1) -->
              <Border DockPanel.Dock="Top" x:Name="MonthsHeader" BorderBrush="{DynamicResource Keel.BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4"
                      IsVisible="{Binding IsThreeMonths}">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,12,0">
                  <TextBlock Grid.Column="0" Classes="columnHeader" Margin="44,0,0,6" VerticalAlignment="Bottom" Text="{x:Static res:Strings.Budget_ColumnCategory}" />
                  <ItemsControl Grid.Column="1" x:Name="MonthHeaderList" ItemsSource="{Binding MonthHeaders}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="b:BudgetMonthHeaderViewModel">
                        <Border Classes="monthColumn" Classes.active="{Binding IsActive}" Width="{x:Static bv:BudgetGridSizes.MonthWidth}">
                          <StackPanel>
                            <Button Classes="monthHeader" Command="{Binding ExplainCommand}" AutomationProperties.Name="{Binding AutomationName}"
                                    ToolTip.Tip="{x:Static res:Strings.Budget_RtaTip}">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Classes="monthName" Text="{Binding Title}" />
                                <TextBlock DockPanel.Dock="Right" Classes="monthRta" Classes.negative="{Binding IsNegative}" Text="{Binding ReadyToAssignText}" />
                                <TextBlock Classes="monthRtaLabel" Text="{x:Static res:Strings.Budget_ReadyToAssign}" />
                              </DockPanel>
                            </Button>
                            <Grid ColumnDefinitions="92,92,*" Margin="0,4,0,0">
                              <TextBlock Grid.Column="0" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{x:Static res:Strings.Budget_ColumnAssigned}" />
                              <TextBlock Grid.Column="1" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{x:Static res:Strings.Budget_ColumnActivity}" />
                              <TextBlock Grid.Column="2" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{x:Static res:Strings.Budget_ColumnAvailable}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
              <ScrollViewer x:Name="GridScroller" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BudgetRows" ItemsSource="{Binding Rows}" Margin="0,0,12,0">
                  <ItemsControl.ItemTemplate>
                    <bv:BudgetRowTemplateSelector>
                      <bv:BudgetRowTemplateSelector.Group>
                        <DataTemplate x:DataType="b:BudgetGroupRowViewModel">
                          <Border Classes="budgetGroupRow" AutomationProperties.Name="{Binding AutomationName}">
                            <Grid ColumnDefinitions="*,124,124,136" MinHeight="34">
                              <Border Grid.Column="0" Tag="Name" Classes="budgetCell" Classes.cursor="{Binding IsNameSelected}" Padding="2,0,6,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Button Classes="expander small" Theme="{StaticResource IconButtonTheme}" AutomationProperties.Name="{Binding ExpandLabel}">
                                    <controls:Icon Data="{StaticResource Icon.ChevronDown}" Classes.collapsed="{Binding !IsExpanded}" />
                                  </Button>
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="1" Tag="Assigned" Classes="budgetCell" Classes.cursor="{Binding IsAssignedSelected}">
                                <TextBlock Classes="groupAmount" Text="{Binding AssignedText}" />
                              </Border>
                              <Border Grid.Column="2" Tag="Activity" Classes="budgetCell" Classes.cursor="{Binding IsActivitySelected}">
                                <TextBlock Classes="groupAmount" Text="{Binding ActivityText}" />
                              </Border>
                              <Border Grid.Column="3" Tag="Available" Classes="budgetCell" Classes.cursor="{Binding IsAvailableSelected}">
                                <TextBlock Classes="groupAmount" Text="{Binding AvailableText}" Margin="0,0,10,0" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </bv:BudgetRowTemplateSelector.Group>
                      <bv:BudgetRowTemplateSelector.Category>
                        <DataTemplate x:DataType="b:BudgetCategoryRowViewModel">
                          <Border Classes="budgetRow" Classes.selected="{Binding IsSelected}" Classes.dropTarget="{Binding IsDropTarget}"
                                  DragDrop.AllowDrop="True" AutomationProperties.Name="{Binding AutomationName}">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="{x:Static res:Strings.Quick_AssignedLastMonth}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.AssignedLastMonth}" />
                                <MenuItem Header="{x:Static res:Strings.Quick_SpentLastMonth}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.SpentLastMonth}" />
                                <MenuItem Header="{x:Static res:Strings.Quick_AverageAssigned}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.AverageAssigned}" />
                                <MenuItem Header="{x:Static res:Strings.Quick_AverageSpent}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.AverageSpent}" />
                                <MenuItem Header="{x:Static res:Strings.Quick_FundTarget}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.FundTarget}"
                                          IsEnabled="{Binding HasTarget}" />
                                <MenuItem Header="{x:Static res:Strings.Quick_ResetToZero}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.ResetToZero}" />
                                <Separator />
                                <MenuItem Header="{x:Static res:Strings.Budget_MoveMoneyMenu}" Command="{Binding MoveMoneyCommand}" InputGesture="M" />
                                <MenuItem Header="{x:Static res:Strings.Budget_SetTargetMenu}" Command="{Binding EditTargetCommand}" InputGesture="T" />
                                <MenuItem Header="{x:Static res:Strings.Budget_ActivityTip}" Command="{Binding ShowTransactionsCommand}" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="*,124,124,136" MinHeight="36">
                              <Border Grid.Column="0" Tag="Name" Classes="budgetCell" Classes.cursor="{Binding IsNameSelected}" Padding="36,2,6,2">
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Classes="targetBadge" Classes.underfunded="{Binding IsUnderfunded}" IsVisible="{Binding HasTarget}"
                                            ToolTip.Tip="{Binding TargetToolTip}">
                                      <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:Icon Data="{StaticResource Icon.Flag}" Width="10" Height="10" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TargetBadgeText}" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Classes="cardDetail" Classes.uncovered="{Binding IsCardUncovered}" Text="{Binding CardDetailText}"
                                             IsVisible="{Binding HasCardDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="1" Tag="Assigned" Classes="budgetCell" Classes.cursor="{Binding IsAssignedSelected}">
                                <Panel>
                                  <TextBlock Classes="cellAmount" Text="{Binding AssignedText}" IsVisible="{Binding !IsEditing}" Margin="0,0,4,0" />
                                  <!-- Created only while the row edits, so building and rebuilding rows stays cheap -->
                                  <ContentControl Content="{Binding EditorRow}">
                                    <ContentControl.ContentTemplate>
                                      <DataTemplate x:DataType="b:BudgetCategoryRowViewModel">
                                        <controls:MoneyTextBox x:Name="AssignedEditor" Classes="assignedEditor"
                                                               Value="{Binding EditValue}" Currency="{Binding Currency}" ShowZeroAsEmpty="False"
                                                               AutomationProperties.Name="{x:Static res:Strings.Budget_ColumnAssigned}" />
                                      </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                  </ContentControl>
                                </Panel>
                              </Border>
                              <Border Grid.Column="2" Tag="Activity" Classes="budgetCell" Classes.cursor="{Binding IsActivitySelected}">
                                <Button Classes="activityLink" Content="{Binding ActivityText}" ToolTip.Tip="{x:Static res:Strings.Budget_ActivityTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.Budget_ActivityTip}" />
                              </Border>
                              <Border Grid.Column="3" Tag="Available" Classes="budgetCell" Classes.cursor="{Binding IsAvailableSelected}">
                                <Border x:Name="AvailablePill" Classes="pill" Classes.positive="{Binding IsPositive}"
                                        Classes.credit="{Binding IsCreditOverspent}" Classes.cash="{Binding IsCashOverspent}"
                                        ToolTip.Tip="{x:Static res:Strings.Budget_PillTip}">
                                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <controls:Icon Data="{StaticResource Icon.CreditCard}" Width="12" Height="12" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsCreditOverspent}" />
                                    <controls:Icon Data="{StaticResource Icon.Alert}" Width="12" Height="12" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsCashOverspent}" />
                                    <TextBlock Text="{Binding AvailableText}" />
                                  </StackPanel>
                                </Border>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </bv:BudgetRowTemplateSelector.Category>
                      <bv:BudgetRowTemplateSelector.GroupMonths>
                        <DataTemplate x:DataType="b:BudgetGroupRowViewModel">
                          <Border Classes="budgetGroupRow" AutomationProperties.Name="{Binding AutomationName}">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="34">
                              <Border Grid.Column="0" Tag="Name" Classes="budgetCell" Classes.cursor="{Binding IsNameSelected}" Padding="2,0,6,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Button Classes="expander small" Theme="{StaticResource IconButtonTheme}" AutomationProperties.Name="{Binding ExpandLabel}">
                                    <controls:Icon Data="{StaticResource Icon.ChevronDown}" Classes.collapsed="{Binding !IsExpanded}" />
                                  </Button>
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                              <ItemsControl Grid.Column="1" ItemsSource="{Binding Months}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="b:BudgetMonthCellViewModel">
                                    <Grid Classes="monthCells" Classes.active="{Binding IsActive}" ColumnDefinitions="92,92,*" Width="{x:Static bv:BudgetGridSizes.MonthWidth}">
                                      <Border Grid.Column="0" Tag="Assigned" Classes="budgetCell compact" Classes.cursor="{Binding IsAssignedSelected}">
                                        <TextBlock Classes="groupAmount" Text="{Binding AssignedText}" />
                                      </Border>
                                      <Border Grid.Column="1" Tag="Activity" Classes="budgetCell compact" Classes.cursor="{Binding IsActivitySelected}">
                                        <TextBlock Classes="groupAmount" Text="{Binding ActivityText}" />
                                      </Border>
                                      <Border Grid.Column="2" Tag="Available" Classes="budgetCell compact" Classes.cursor="{Binding IsAvailableSelected}">
                                        <TextBlock Classes="groupAmount" Text="{Binding AvailableText}" Margin="0,0,6,0" />
                                      </Border>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </bv:BudgetRowTemplateSelector.GroupMonths>
                      <bv:BudgetRowTemplateSelector.CategoryMonths>
                        <DataTemplate x:DataType="b:BudgetCategoryRowViewModel">
                          <Border Classes="budgetRow" Classes.selected="{Binding IsSelected}" Classes.dropTarget="{Binding IsDropTarget}"
                                  DragDrop.AllowDrop="True" AutomationProperties.Name="{Binding AutomationName}">
                            <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{x:Static res:Strings.Quick_AssignedLastMonth}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.AssignedLastMonth}" />
                              <MenuItem Header="{x:Static res:Strings.Quick_SpentLastMonth}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.SpentLastMonth}" />
                              <MenuItem Header="{x:Static res:Strings.Quick_AverageAssigned}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.AverageAssigned}" />
                              <MenuItem Header="{x:Static res:Strings.Quick_AverageSpent}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.AverageSpent}" />
                              <MenuItem Header="{x:Static res:Strings.Quick_FundTarget}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.FundTarget}"
                                        IsEnabled="{Binding HasTarget}" />
                              <MenuItem Header="{x:Static res:Strings.Quick_ResetToZero}" Command="{Binding QuickAssignCommand}" CommandParameter="{x:Static b:QuickAssignKind.ResetToZero}" />
                              <Separator />
                              <MenuItem Header="{x:Static res:Strings.Budget_MoveMoneyMenu}" Command="{Binding MoveMoneyCommand}" InputGesture="M" />
                              <MenuItem Header="{x:Static res:Strings.Budget_SetTargetMenu}" Command="{Binding EditTargetCommand}" InputGesture="T" />
                              <MenuItem Header="{x:Static res:Strings.Budget_ActivityTip}" Command="{Binding ShowTransactionsCommand}" />
                            </ContextMenu>
                          </Border.ContextMenu>
                            <Grid ColumnDefinitions="*,Auto" MinHeight="36">
                              <Border Grid.Column="0" Tag="Name" Classes="budgetCell" Classes.cursor="{Binding IsNameSelected}" Padding="36,2,6,2">
                              <StackPanel VerticalAlignment="Center" Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <Border Classes="targetBadge" Classes.underfunded="{Binding IsUnderfunded}" IsVisible="{Binding HasTarget}"
                                          ToolTip.Tip="{Binding TargetToolTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <controls:Icon Data="{StaticResource Icon.Flag}" Width="10" Height="10" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding TargetBadgeText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </StackPanel>
                                <TextBlock Classes="cardDetail" Classes.uncovered="{Binding IsCardUncovered}" Text="{Binding CardDetailText}"
                                           IsVisible="{Binding HasCardDetail}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                              <ItemsControl Grid.Column="1" ItemsSource="{Binding Months}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="b:BudgetMonthCellViewModel">
                                    <Grid Classes="monthCells" Classes.active="{Binding IsActive}" ColumnDefinitions="92,92,*" Width="{x:Static bv:BudgetGridSizes.MonthWidth}">
                                      <Border Grid.Column="0" Tag="Assigned" Classes="budgetCell compact" Classes.cursor="{Binding IsAssignedSelected}">
                                        <Panel>
                                          <TextBlock Classes="cellAmount" Text="{Binding AssignedText}" IsVisible="{Binding !IsEditing}" Margin="0,0,4,0" />
                                          <!-- The editor exists only while this cell edits (three per row would slow the mode switch) -->
                                          <ContentControl Content="{Binding EditorRow}">
                                            <ContentControl.ContentTemplate>
                                              <DataTemplate x:DataType="b:BudgetCategoryRowViewModel">
                                                <controls:MoneyTextBox x:Name="AssignedEditor" Classes="assignedEditor"
                                                                       Value="{Binding EditValue}" Currency="{Binding Currency}" ShowZeroAsEmpty="False"
                                                                       AutomationProperties.Name="{x:Static res:Strings.Budget_ColumnAssigned}" />
                                              </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                          </ContentControl>
                                        </Panel>
                                      </Border>
                                      <Border Grid.Column="1" Tag="Activity" Classes="budgetCell compact" Classes.cursor="{Binding IsActivitySelected}">
                                        <Button Classes="activityLink" Content="{Binding ActivityText}" ToolTip.Tip="{x:Static res:Strings.Budget_ActivityTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.Budget_ActivityTip}" />
                                      </Border>
                                      <Border Grid.Column="2" Tag="Available" Classes="budgetCell compact" Classes.cursor="{Binding IsAvailableSelected}">
                                        <Border Classes="pill compact" Classes.positive="{Binding IsPositive}"
                                                Classes.credit="{Binding IsCreditOverspent}" Classes.cash="{Binding IsCashOverspent}"
                                                ToolTip.Tip="{x:Static res:Strings.Budget_PillTip}" AutomationProperties.Name="{Binding AutomationName}">
                                          <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                            <controls:Icon Data="{StaticResource Icon.CreditCard}" Width="11" Height="11" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsCreditOverspent}" />
                                            <controls:Icon Data="{StaticResource Icon.Alert}" Width="11" Height="11" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsCashOverspent}" />
                                            <TextBlock Text="{Binding AvailableText}" />
                                          </StackPanel>
                                        </Border>
                                      </Border>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </bv:BudgetRowTemplateSelector.CategoryMonths>
                    </bv:BudgetRowTemplateSelector>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The Flex view (F-BUD-6, ADR 0091) -->
      <ContentControl x:Name="FlexHost" Content="{Binding Flex}" IsVisible="{Binding ShowFlex}" />
    </Panel>
    </Grid>
  </DockPanel>
</UserControl>
