<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Keel.Desktop.Controls">
  <!-- Bank sync (M7): connection health dots (PRD 9.1) and the syncing spinner. -->
  <Style Selector="Ellipse.health">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource Keel.TextSecondary}" />
  </Style>
  <Style Selector="Ellipse.health.ok">
    <Setter Property="Fill" Value="{DynamicResource Keel.Positive}" />
  </Style>
  <Style Selector="Ellipse.health.attention">
    <Setter Property="Fill" Value="{DynamicResource Keel.Warning}" />
  </Style>
  <Style Selector="Ellipse.health.error">
    <Setter Property="Fill" Value="{DynamicResource Keel.Negative}" />
  </Style>

  <!-- The syncing spinner turns only when motion is not reduced (PRD 9.11); the icon and its text stay. -->
  <Style Selector="controls|Icon.spin">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="Window:not(.reduceMotion) controls|Icon.spin">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A masked value that is set: dots, never the value. -->
  <Style Selector="TextBlock.maskedValue">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Keel.TextSecondary}" />
  </Style>

  <Style Selector="Border.connectionRow">
    <Setter Property="BorderBrush" Value="{DynamicResource Keel.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.emptyConnections">
    <Setter Property="BorderBrush" Value="{DynamicResource Keel.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Keel.WindowBackground}" />
  </Style>
</Styles>
